SELECT
    first_name,
    last_name,
    phone_number,
    COUNT(*) AS duplicate_count
FROM tbl_customer
GROUP BY
    first_name,
    last_name,
    phone_number
HAVING COUNT(*) > 1;

WITH DuplicateCustomers AS
(
    SELECT *,
    ROW_NUMBER() OVER (
        PARTITION BY first_name, last_name, phone_number
        ORDER BY customer_id
    ) AS row_num
    FROM tbl_customer
)

DELETE FROM DuplicateCustomers
WHERE row_num > 1;

SELECT
    c.first_name,
    r.restaurant_name,
    m.item_name,
    o.quantity,
    o.total_amount,
    p.payment_method,
    p.payment_status
FROM tbl_customer c
INNER JOIN mst_restaurant r
ON c.restaurant_id = r.restaurant_id
INNER JOIN tbl_orders o
ON c.customer_id = o.customer_id
INNER JOIN mst_menu m
ON o.menu_id = m.menu_id
INNER JOIN tbl_payment p
ON o.order_id = p.order_id
WHERE c.is_active = 1;

