SELECT
first_name,
last_name,
phone_number,
COUNT(*) AS duplicate_count
FROM tbl_customer
GROUP BY
first_name,
last_name,
phone_number
HAVING COUNT(*) > 1;

WITH DuplicateCustomers AS
(
SELECT *,
ROW_NUMBER() OVER (
PARTITION BY first_name, last_name, phone_number
ORDER BY customer_id
) AS row_num
FROM tbl_customer
)

DELETE FROM DuplicateCustomers
WHERE row_num > 1;

