CREATE PROCEDURE usp_GetActiveCustomersByrestaurantid
@restaurant_id INT
AS
BEGIN
SET NOCOUNT ON;
SELECT first_name,
       last_name
from tbl_customer
where  restaurant_id = @restaurant_id and is_active = 1;
end;

exec usp_GetActiveCustomersByrestaurantid @restaurant_id = 1;






