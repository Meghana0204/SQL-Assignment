CREATE PROCEDURE usp_DeleteCustomer
@customer_id INT
AS
BEGIN
SET NOCOUNT ON;
UPDATE tbl_customer
SET
is_active = 0, updated_on = CURRENT_TIMESTAMP
WHERE customer_id = @customer_id;
END;

